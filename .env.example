# 仅供服务端读取，不要使用 VITE_ 前缀保存密钥。修改后重启服务。
TTS_PROVIDER=qwen
PORT=8082

# DeepSeek：用于家长中心“一句话新增资料”，密钥仅由服务端读取
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 千问：北京地域工作空间 ID 与对应 API Key
QWEN_WORKSPACE_ID=
QWEN_API_KEY=
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.6
QWEN_TTS_EN_VOICE=loongeva_v3.6

# 豆包：新版 API Key；旧版可改填 APP_ID 和 ACCESS_KEY
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts

# MiniMax 国内开放平台
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=female-shaonv
