# 仅供服务端读取，不要使用 VITE_ 前缀保存密钥。修改后重启服务。
TTS_PROVIDER=qwen
PORT=8082

# PostgreSQL：宝塔 PostgreSQL 插件或 compose.postgres.yaml 均可。
# 生产环境建议 DATABASE_REQUIRED=true；应用启动时会自动创建所需表。
DATABASE_URL=postgresql://lexue:请替换强密码@127.0.0.1:5432/lexue
DATABASE_REQUIRED=false
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# 至少32字节的随机字符串；修改后所有已登录会话都会失效。
SESSION_SECRET=
REGISTRATION_ENABLED=true
ADMIN_EMAILS=
GUEST_SESSION_DAYS=30
ACCOUNT_SESSION_DAYS=14

# 用户额度、分钟限流与全站付费调用硬上限。
GUEST_TTS_DAILY_LIMIT=30
GUEST_AI_DAILY_LIMIT=0
ACCOUNT_TTS_DAILY_LIMIT=300
ACCOUNT_AI_DAILY_LIMIT=20
TTS_PER_MINUTE_LIMIT=30
AI_PER_MINUTE_LIMIT=5
TTS_IP_PER_MINUTE_LIMIT=60
AI_IP_PER_MINUTE_LIMIT=10
TTS_GLOBAL_DAILY_UPSTREAM_LIMIT=5000
AI_GLOBAL_DAILY_LIMIT=500
# 仅用于管理后台预估费用，请按供应商实际账单单位调整。
TTS_10K_CHARACTERS_ESTIMATED_COST=2
AI_MILLION_TOKEN_ESTIMATED_COST=3
SYNC_MAX_BYTES=5242880
CONTENT_PACK_MAX_BYTES=5242880

# 语音三级缓存：浏览器 + 本机目录 + 阿里云 OSS。
TTS_CACHE_DIR=/app/data/tts-cache
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_INTERNAL=false
OSS_TTS_PREFIX=lexue/tts/


# DeepSeek：用于家长中心“一句话新增资料”，密钥仅由服务端读取
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 千问：北京地域工作空间 ID 与对应 API Key
QWEN_WORKSPACE_ID=
QWEN_API_KEY=
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.6
QWEN_TTS_EN_VOICE=loongeva_v3.6

# 豆包：新版 API Key；旧版可改填 APP_ID 和 ACCESS_KEY
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts

# MiniMax 国内开放平台
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=female-shaonv
