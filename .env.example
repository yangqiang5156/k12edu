# 统一配置项清单：.env 与 .env.example 的字段、顺序和说明保持一致。
# 两份文件的实际值可以不同：.env 保存私有配置；.env.example 不得填写真实密钥或账号信息。
# 禁止用示例文件覆盖已有.env；修改后重启服务。VITE_前缀变量不得保存密钥。

# 运行与部署：本地与阿里云使用相同配置项，实际值按环境填写。
# 服务监听地址；当前默认0.0.0.0，Docker依靠端口绑定限制外部访问。
HOST='0.0.0.0'
# 直接运行Node服务的端口；Vite开发端口另行管理，Docker容器内会覆盖为80。
PORT='8082'
# 仅Docker部署使用的应用镜像完整名称，如ghcr.io/yangqiang5156/k12edu:v0.12.2；自动发布会更新。
LEXUE_IMAGE=''
# Docker映射到宿主127.0.0.1的端口，必须与Nginx反向代理目标端口一致。
LEXUE_PORT='8080'
# 生产站点来源，用于校验浏览器Origin；只含协议和域名，不含/lexue/。
PUBLIC_ORIGIN='https://ai.liqi123.com'
# 家庭故事音频代理链接的应用路径，需与Nginx一致并以/结尾；不控制Vite打包路径。
APP_BASE_PATH='/lexue/'
# 逗号分隔的可信代理IP；生产Docker需填写实际桥接网关IP，不能信任任意客户端。
TRUSTED_PROXY_IPS='127.0.0.1,::1'

# 数据库：连接应用数据库与初始化Docker数据库是两套用途，不能混淆。
# 应用连接串（含私有密码）；密码特殊字符需URL编码。容器中localhost指容器本身，应使用实际数据库地址。
DATABASE_URL='postgresql://lexue:请替换强密码@127.0.0.1:5432/lexue'
# true表示数据库不可用时拒绝启动；生产建议true。Vite开发/预览使用独立本地会话，不连接该数据库。
DATABASE_REQUIRED='false'
# 数据库连接是否启用TLS；按数据库实际要求填写true或false。
DATABASE_SSL='false'
# TLS启用时是否校验服务端证书；建议true，避免跳过证书校验。
DATABASE_SSL_REJECT_UNAUTHORIZED='true'
# 应用数据库连接池最大连接数。
DATABASE_POOL_MAX='10'
# 仅Docker PostgreSQL初始化使用的数据库名；已有数据库不会因改此项自动重建。
POSTGRES_DB='lexue'
# 仅Docker PostgreSQL初始化使用的用户名，需与DATABASE_URL对应。
POSTGRES_USER='lexue'
# 仅Docker PostgreSQL初始化使用的强密码，部署数据库时必填；已有库需单独修改密码，不能只改此项。
POSTGRES_PASSWORD=''

# 会话与权限：全局允许生成不等于给家庭开通生成权限。
# 私有会话签名密钥，至少32字节随机字符串；更换后已有登录会话失效，禁止提交或公开。
SESSION_SECRET=''
# 是否开放家庭注册；true允许注册普通账号，不自动获得管理员或生成权限。
REGISTRATION_ENABLED='true'
# 游客会话有效期，单位天，代码限制为1至30天。
GUEST_SESSION_DAYS='30'
# 家庭登录会话有效期，单位天，代码限制为1至30天。
ACCOUNT_SESSION_DAYS='14'
# 付费生成全局开关；false关闭新语音和AI生成。true仍需登录且由管理员单独开通家庭权限。
PAID_SERVICES_ENABLED='true'
# 仅无数据库的本地开发放行付费调用；生产保持false，true可能产生真实供应商费用。
ALLOW_LOCAL_PAID_SERVICES='false'
# 旧配置兼容保留字段，当前代码不使用，不会自动授予管理员；使用server/manage-access.mjs显式授权。
ADMIN_EMAILS=''

# 会话创建、API保护与数据上传大小。
# 全站API同时处理的最大请求数。
API_MAX_CONCURRENCY='40'
# 全站API每分钟请求数上限。
API_GLOBAL_PER_MINUTE_LIMIT='600'
# 全站每日注册尝试次数上限，不是家庭账号总数上限。
REGISTRATION_GLOBAL_DAILY_LIMIT='200'
# 全站每日新建游客会话次数上限。
GUEST_GLOBAL_DAILY_SESSION_LIMIT='10000'
# 家庭云同步请求体大小上限，单位字节；5242880为5MiB。
SYNC_MAX_BYTES='5242880'
# 管理员发布内容包请求体大小上限，单位字节；5242880为5MiB。
CONTENT_PACK_MAX_BYTES='5242880'

# 个人/家庭次数与分钟限流：已有账号额度存于数据库，修改新账号默认值不会覆盖已有额度。
# 每个游客设备每日朗读请求上限；游客只可获取已有缓存，不允许付费合成新音频。
GUEST_TTS_DAILY_LIMIT='30'
# 游客AI每日额度预留项；当前新AI生成仍要求已开通家庭，调高此项不会给游客开通生成。
GUEST_AI_DAILY_LIMIT='0'
# 新注册家庭的每日朗读次数默认值；已有家庭额度在运营管理中修改。
ACCOUNT_TTS_DAILY_LIMIT='300'
# 新注册家庭的每日AI生成次数默认值；已有家庭额度在运营管理中修改。
ACCOUNT_AI_DAILY_LIMIT='20'
# 每个家庭或游客设备每分钟朗读请求上限，含缓存读取。
TTS_PER_MINUTE_LIMIT='30'
# 每个家庭每分钟AI生成请求上限。
AI_PER_MINUTE_LIMIT='5'
# 同一可信客户端IP每分钟朗读请求上限。
TTS_IP_PER_MINUTE_LIMIT='60'
# 同一可信客户端IP每分钟AI生成请求上限。
AI_IP_PER_MINUTE_LIMIT='10'

# 全站与家庭预算：每日计数按UTC日期统计，预算与供应商账单余额独立。
# 全站每日朗读请求计数上限，含服务端缓存请求。
TTS_GLOBAL_DAILY_REQUEST_LIMIT='10000'
# 全站每日上游语音请求上限，用于限制真实供应商调用。
TTS_GLOBAL_DAILY_UPSTREAM_LIMIT='5000'
# 全站每日上游语音输入字符预算。
TTS_GLOBAL_DAILY_CHARACTER_LIMIT='50000'
# 每个家庭每日上游语音输入字符预算。
TTS_FAMILY_DAILY_CHARACTER_LIMIT='10000'
# 全站上游语音并发数上限；朗读接口另有最多3个活动请求的保护。
TTS_GLOBAL_CONCURRENCY='3'
# 全站每日AI生成请求上限，亦用于上游预算保护。
AI_GLOBAL_DAILY_LIMIT='500'
# 全站每日AI token预算（请求会先预留预算）。
AI_GLOBAL_DAILY_TOKEN_LIMIT='200000'
# 每个家庭每日AI token预算。
AI_FAMILY_DAILY_TOKEN_LIMIT='30000'
# 全站上游AI并发数上限。
AI_GLOBAL_CONCURRENCY='2'
# 后台预估费用：每一万语音字符的人民币价格，仅估算，不控制供应商收费。
TTS_10K_CHARACTERS_ESTIMATED_COST='2'
# 后台预估费用：每一百万AI token的人民币价格，仅估算，不控制供应商收费。
AI_MILLION_TOKEN_ESTIMATED_COST='3'

# 故事与音频下载保护。
# 每个家庭可保存的故事数量上限；达到上限需归档旧故事。
STORY_FAMILY_LIMIT='50'
# 每个家庭每日故事生成次数上限；仍要求家庭生成权限。
STORY_DAILY_GENERATION_LIMIT='3'
# 服务端故事合成临时目录，需要可写；Docker使用/app/data/story-work并持久化在宿主data目录。
STORY_WORK_DIR='/app/data/story-work'
# 仅stories:upload上传脚本使用的本地音频来源目录；留空使用脚本默认查找目录。
STORY_AUDIO_SOURCE_DIR=''
# 同一IP每分钟故事音频播放/下载请求上限（含Range请求）。
AUDIO_IP_PER_MINUTE_LIMIT='60'
# 全站每日故事音频播放/下载请求数上限。
AUDIO_GLOBAL_DAILY_REQUEST_LIMIT='10000'
# 全站每日故事音频传输字节预算；1073741824为1GiB。
AUDIO_GLOBAL_DAILY_BYTE_LIMIT='1073741824'
# 同一IP每日故事音频播放/下载请求数上限。
AUDIO_IP_DAILY_REQUEST_LIMIT='1000'
# 同一IP每日故事音频传输字节预算；104857600为100MiB。
AUDIO_IP_DAILY_BYTE_LIMIT='104857600'

# 语音提供商：只需配置实际选中的提供商，其余密钥可留空。
# 在线合成提供商，可选qwen、doubao或minimax；切换不会自动给家庭开通权限。
TTS_PROVIDER='qwen'
# 千问北京地域工作空间ID，与所用API Key对应；选择qwen时必填。
QWEN_WORKSPACE_ID=''
# 千问私有API Key；选择qwen时必填，只能供服务端使用。
QWEN_API_KEY=''
# 千问语音模型名称，也用于故事录制与音频缓存区分。
QWEN_TTS_MODEL='qwen-audio-3.1-tts-flash'
# 千问中文/自动语言默认音色，必须与模型兼容。
QWEN_TTS_VOICE='longanhuan_v3.1'
# 千问英文默认音色，必须与模型兼容。
QWEN_TTS_EN_VOICE='Abby_v3.1'
# 豆包新版私有API Key；选择doubao时优先使用此项。
DOUBAO_API_KEY=''
# 豆包旧版认证的应用ID，仅未使用新版API Key时填写。
DOUBAO_APP_ID=''
# 豆包旧版私有访问密钥，与旧版APP_ID配套。
DOUBAO_ACCESS_KEY=''
# 豆包语音资源ID，需与开通的模型/音色匹配。
DOUBAO_TTS_RESOURCE_ID='seed-tts-2.0'
# 豆包默认音色标识。
DOUBAO_TTS_VOICE='zh_female_vv_uranus_bigtts'
# MiniMax国内开放平台私有API Key；选择minimax时必填。
MINIMAX_API_KEY=''
# MiniMax语音模型名称。
MINIMAX_TTS_MODEL='speech-2.8-turbo'
# MiniMax默认音色标识。
MINIMAX_TTS_VOICE='female-shaonv'

# 大模型：用于资料生成与家庭故事生成。
# DeepSeek私有API Key；使用AI生成时必填，仅供服务端读取。
DEEPSEEK_API_KEY=''
# DeepSeek模型名称，需在对应供应商账号可用。
DEEPSEEK_MODEL='deepseek-v4-flash'

# 本地语音缓存与阿里云OSS：桶保持私有，访问密钥只放私有.env。
# 服务端可写语音缓存目录；Docker通常/app/data/tts-cache，本地填写实际可写路径。
TTS_CACHE_DIR='/app/data/tts-cache'
# 本机语音缓存容量上限，单位字节；536870912为512MiB。
TTS_CACHE_MAX_BYTES='536870912'
# 本机语音缓存有效期，单位天；过期缓存会重新读取OSS或按权限重新生成。
TTS_CACHE_TTL_DAYS='7'
# 阿里云OSS地域标识，需与桶一致。
OSS_REGION='oss-cn-beijing'
# 私有OSS桶名称；启用OSS还需地域及访问密钥。
OSS_BUCKET=''
# OSS专用RAM访问密钥ID；不要使用前端环境变量或写入公开模板。
OSS_ACCESS_KEY_ID=''
# OSS专用RAM私有访问密钥，禁止提交或公开。
OSS_ACCESS_KEY_SECRET=''
# OSS服务域名，按桶地域填写；留空时由SDK按地域选择。
OSS_ENDPOINT='oss-cn-beijing.aliyuncs.com'
# 语音缓存是否走阿里云内网Endpoint；仅同地域且网络可达时设true。
OSS_INTERNAL='false'
# OSS中语音缓存对象的路径前缀。
OSS_TTS_PREFIX='lexue/tts/'
# OSS中故事音频对象的路径前缀，区分builtin与families。
OSS_STORY_PREFIX='lexue/stories'
# 故事存储是否使用内网Endpoint；仅确认服务器网络可达时设true。
OSS_STORY_INTERNAL='false'
# 兼容存储工具生成OSS签名地址的秒数；当前家庭音频接口使用独立的短期会话绑定代理链接。
STORY_AUDIO_URL_TTL_SECONDS='7200'
# 旧公共音频地址兼容字段；建议留空，当前故事API不使用该地址，不应为此开放OSS桶。
STORY_AUDIO_PUBLIC_BASE_URL=''
