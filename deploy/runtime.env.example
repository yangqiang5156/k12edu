# 复制为部署目录中的 .env.runtime，权限设置为 600。不要提交真实密钥。
DATABASE_URL=postgresql://lexue:请替换强密码@宝塔PostgreSQL地址:5432/lexue
DATABASE_REQUIRED=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
SESSION_SECRET=请替换至少32字节随机字符串
REGISTRATION_ENABLED=true
ADMIN_EMAILS=admin@example.com

GUEST_TTS_DAILY_LIMIT=30
ACCOUNT_TTS_DAILY_LIMIT=300
ACCOUNT_AI_DAILY_LIMIT=20
TTS_PER_MINUTE_LIMIT=30
AI_PER_MINUTE_LIMIT=5
TTS_IP_PER_MINUTE_LIMIT=60
AI_IP_PER_MINUTE_LIMIT=10
TTS_GLOBAL_DAILY_UPSTREAM_LIMIT=5000
AI_GLOBAL_DAILY_LIMIT=500
TTS_10K_CHARACTERS_ESTIMATED_COST=0
AI_MILLION_TOKEN_ESTIMATED_COST=0

TTS_CACHE_DIR=/app/data/tts-cache
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_INTERNAL=true
OSS_TTS_PREFIX=lexue/tts/

TTS_PROVIDER=qwen
QWEN_WORKSPACE_ID=
QWEN_API_KEY=
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.6
QWEN_TTS_EN_VOICE=loongeva_v3.6

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
