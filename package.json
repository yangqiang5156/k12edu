{
  "name": "lexue-workbench",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && cp LICENSE dist/LICENSE",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloud": "node --env-file-if-exists=.env scripts/cloud-smoke.mjs",
    "test:infra": "node --env-file-if-exists=.env scripts/infrastructure-smoke.mjs",
    "test:tts-cache": "node --env-file-if-exists=.env scripts/tts-cache-smoke.mjs",
    "stories:upload": "node --env-file-if-exists=.env scripts/upload-story-audio.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:local": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "idb": "^8.0.3",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
