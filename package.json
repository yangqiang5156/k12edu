{
  "name": "lexue-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "audio:numbers": "bash scripts/generate-number-audio.sh",
    "audio:literacy": "bash scripts/generate-literacy-audio.sh",
    "audio:letters": "bash scripts/generate-english-letter-audio.sh",
    "audio:guoxue": "bash scripts/generate-guoxue-audio.sh",
    "audio:all": "pnpm audio:numbers && pnpm audio:literacy && pnpm audio:letters && pnpm audio:guoxue"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
